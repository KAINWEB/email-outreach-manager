APP_NAME=Email Outreach Manager
DATABASE_URL=sqlite:///../data/email_outreach.db
UPLOAD_DIR=../data/uploads
EXPORT_DIR=../data/exports
LOG_LEVEL=INFO
LOG_FILE=../data/email_outreach.log
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_OUTREACH_SECRET_KEY=
WORKER_POLL_SECONDS=1.0
MAX_RETRY_ATTEMPTS=3

# Optional Gmail API OAuth (Google Cloud -> OAuth Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/gmail/callback
